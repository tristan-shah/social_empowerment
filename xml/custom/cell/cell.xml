<mujoco model="cell">
    <worldbody>

        <body name="body_cell:0" pos="0.0 0 0.1">
            <joint name="x_joint_cell:0" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:0" type="slide" axis="0 0 1"/>
            <geom name="cell:0" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:0" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:1" pos="0.5 0 0.1">
            <joint name="x_joint_cell:1" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:1" type="slide" axis="0 0 1"/>
            <geom name="cell:1" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:1" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:2" pos="0.0 0 0.6">
            <joint name="x_joint_cell:2" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:2" type="slide" axis="0 0 1"/>
            <geom name="cell:2" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:2" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:3" pos="0.5 0 0.6">
            <joint name="x_joint_cell:3" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:3" type="slide" axis="0 0 1"/>
            <geom name="cell:3" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:3" pos="0 0 0" size="0.01"/>
        </body>
    </worldbody>


    <tendon>
        <spatial name="spring_0_1" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:0"/>
            <site site="site_cell:1"/>
        </spatial>

        <spatial name="spring_0_2" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:0"/>
            <site site="site_cell:2"/>
        </spatial>

        <spatial name="spring_2_3" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:2"/>
            <site site="site_cell:3"/>
        </spatial>

        <spatial name="spring_3_1" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:3"/>
            <site site="site_cell:1"/>
        </spatial>

        <spatial name="spring_1_2" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:1"/>
            <site site="site_cell:2"/>
        </spatial>

        <spatial name="spring_3_0" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:3"/>
            <site site="site_cell:0"/>
        </spatial>
    </tendon>

    <actuator>
        <motor joint="x_joint_cell:0" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:0" ctrlrange="-1 1" gear="2"/>

        <motor joint="x_joint_cell:1" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:1" ctrlrange="-1 1" gear="2"/>

        <motor joint="x_joint_cell:2" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:2" ctrlrange="-1 1" gear="2"/>

        <motor joint="x_joint_cell:3" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:3" ctrlrange="-1 1" gear="2"/>
    </actuator>
</mujoco>