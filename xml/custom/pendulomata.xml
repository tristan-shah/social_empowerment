<mujoco model="pendulomata">

    <!-- <compiler angle="radian"/> -->
    <option integrator="implicitfast" timestep="0.01" gravity="0 0 -9.81"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.3 0.3 0.4" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light name="global_light" directional="true" diffuse="1 1 1" specular="0.3 0.3 0.3" castshadow="false"/>
        <light name="fill_light_0" pos="-5 0 10" dir="0 0 -1" directional="false" diffuse="1 1 1" specular="0.2 0.2 0.2"/>
        <light name="fill_light_1" pos="0 0 10" dir="0 0 -1" directional="false" diffuse="1 1 1" specular="0.2 0.2 0.2"/>
        <light name="fill_light_2" pos="5 0 10" dir="0 0 -1" directional="false" diffuse="1 1 1" specular="0.2 0.2 0.2"/>

        <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

        <!-- Pendulum base -->
        <body name="pendulum:0" pos="-1.0 -0.5 1.2">
            <joint name="ball:0" type="ball" pos="0 0 0" damping="0.1"/>

            <!-- Rod of the pendulum -->
            <geom name="rod:0" type="capsule" fromto="0 0 0 0 0 -1" size="0.02" mass="1" contype="1" conaffinity="2"/>

            <!-- Mass at the end -->
            <geom name="bob:0" type="sphere" pos="0 0 -1" size="0.05" rgba="0 0 1 1" mass="0" contype="1" conaffinity="2"/>

            <site name="site:0" pos="0 0 -1" size="0.01"/>
        </body>

        <body name="pendulum:1" pos="1.0 -0.5 1.2">
            <joint name="ball:1" type="ball" pos="0 0 0" damping="0.1"/>

            <geom name="rod:1" type="capsule" fromto="0 0 0 0 0 -1" size="0.02" mass="1" contype="1" conaffinity="2"/>

            <geom name="bob:1" type="sphere" pos="0 0 -1" size="0.05" rgba="1 0.5 0 1" mass="0" contype="1" conaffinity="2"/>

            <site name="site:1" pos="0 0 -1" size="0.01"/>
        </body>

        <body name="pendulum:2" pos="-1.0 1.5 1.2">
            <joint name="ball:2" type="ball" pos="0 0 0" damping="0.1"/>

            <geom name="rod:2" type="capsule" fromto="0 0 0 0 0 -1" size="0.02" mass="1" contype="1" conaffinity="2"/>

            <geom name="bob:2" type="sphere" pos="0 0 -1" size="0.05" rgba="1 0.5 0 1" mass="0" contype="1" conaffinity="2"/>

            <site name="site:2" pos="0 0 -1" size="0.01"/>
        </body>

        <body name="pendulum:3" pos="1.0 1.5 1.2">
            <joint name="ball:3" type="ball" pos="0 0 0" damping="0.1"/>

            <geom name="rod:3" type="capsule" fromto="0 0 0 0 0 -1" size="0.02" mass="1" contype="1" conaffinity="2"/>

            <geom name="bob:3" type="sphere" pos="0 0 -1" size="0.05" rgba="1 0.5 0 1" mass="0" contype="1" conaffinity="2"/>

            <site name="site:3" pos="0 0 -1" size="0.01"/>
        </body>
        
    </worldbody>

    <tendon>
        <spatial name="spring_0_1" stiffness="3.0" damping="0.1" springlength="2" rgba="1 0 0 1" width="0.005">
            <site site="site:0"/>
            <site site="site:1"/>
        </spatial>

        <spatial name="spring_0_2" stiffness="3.0" damping="0.1" springlength="2" rgba="1 0 0 1" width="0.005">
            <site site="site:0"/>
            <site site="site:2"/>
        </spatial>

        <spatial name="spring_1_3" stiffness="3.0" damping="0.1" springlength="2" rgba="1 0 0 1" width="0.005">
            <site site="site:1"/>
            <site site="site:3"/>
        </spatial>

        <spatial name="spring_2_3" stiffness="3.0" damping="0.1" springlength="2" rgba="1 0 0 1" width="0.005">
            <site site="site:2"/>
            <site site="site:3"/>
        </spatial>
    </tendon>

    <actuator>
        <motor joint="ball:0" gear="1 0 0"/>
        <motor joint="ball:0" gear="0 1 0"/>

        <motor joint="ball:1" gear="1 0 0"/>
        <motor joint="ball:1" gear="0 1 0"/>

        <motor joint="ball:2" gear="1 0 0"/>
        <motor joint="ball:2" gear="0 1 0"/>

        <motor joint="ball:3" gear="1 0 0"/>
        <motor joint="ball:3" gear="0 1 0"/>
    </actuator>
</mujoco>