<mujoco model="ball scene">
    <statistic center="0 0 0.1" extent="0.8"/>

    <option impratio="20"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
            friction="1 0.005 0.0001"/>
        
        <!-- ball -->
        <body name="ball_body" pos="0.0 0 0.0">
            <joint name="free_joint" type="free" damping="0.01"/>
            <geom name="ball_geom" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"
                friction="1 0.005 0.0001"/>
        </body>

        <!-- goal -->
        <body name="goal_body" pos="-2.0 -1.0 0.1">
            <geom type="box" size="0.1 0.1 0.1" rgba="0 140 0 0.5" contype="0" conaffinity="0"/>
        </body>
        
    </worldbody>

    <actuator>
        <!-- acceleration motors -->
        <!-- <motor joint="free_joint" name="force_x" ctrlrange="-1 1" gear="1 0 0 0 0 0"/>
        <motor joint="free_joint" name="force_y" ctrlrange="-1 1" gear="0 1 0 0 0 0"/> -->
    
        <!-- angular acceleration motors -->
        <motor joint="free_joint" name="torque_x" ctrlrange="-1 1" gear="0 0 0 0.3 0 0"/>
        <motor joint="free_joint" name="torque_y" ctrlrange="-1 1" gear="0 0 0 0 0.3 0"/>
    </actuator>

    <keyframe>
        <key name="home" qpos="0 0 0.1 1 0 0 0"/>
    </keyframe>
</mujoco>
