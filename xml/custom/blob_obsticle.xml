<mujoco model="blob_obsticle">

    <option integrator="implicitfast" timestep="0.05" gravity="0 0 -9.81"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.3 0.3 0.4" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light name="global_light" directional="true" diffuse="1 1 1" specular="0.3 0.3 0.3" castshadow="false"/>
        <light name="fill_light_0" pos="-5 0 10" dir="0 0 -1" directional="false" diffuse="1 1 1" specular="0.2 0.2 0.2"/>
        <light name="fill_light_1" pos="0 0 10" dir="0 0 -1" directional="false" diffuse="1 1 1" specular="0.2 0.2 0.2"/>
        <light name="fill_light_2" pos="5 0 10" dir="0 0 -1" directional="false" diffuse="1 1 1" specular="0.2 0.2 0.2"/>

        <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane" contype="2" conaffinity="1"/>

        <!-- center body cell -->
        <body name="body_cell:3" pos="0.0 0 0.6">
            <joint name="x_joint_cell:3" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:3" type="slide" axis="0 0 1"/>
            <!-- <geom name="cell:3" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2" rgba="60 0 0 1"/> -->
            <geom name="cell:3" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:3" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:0" pos="-0.5 0 0.1">
            <joint name="x_joint_cell:0" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:0" type="slide" axis="0 0 1"/>
            <geom name="cell:0" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:0" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:1" pos="0.0 0 0.1">
            <joint name="x_joint_cell:1" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:1" type="slide" axis="0 0 1"/>
            <geom name="cell:1" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:1" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:2" pos="-0.5 0 0.6">
            <joint name="x_joint_cell:2" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:2" type="slide" axis="0 0 1"/>
            <geom name="cell:2" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:2" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:4" pos="0.5 0 0.1">
            <joint name="x_joint_cell:4" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:4" type="slide" axis="0 0 1"/>
            <geom name="cell:4" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:4" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:5" pos="0.5 0 0.6">
            <joint name="x_joint_cell:5" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:5" type="slide" axis="0 0 1"/>
            <geom name="cell:5" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:5" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:6" pos="-0.5 0 1.1">
            <joint name="x_joint_cell:6" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:6" type="slide" axis="0 0 1"/>
            <geom name="cell:6" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:6" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:7" pos="0.0 0 1.1">
            <joint name="x_joint_cell:7" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:7" type="slide" axis="0 0 1"/>
            <geom name="cell:7" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:7" pos="0 0 0" size="0.01"/>
        </body>

        <body name="body_cell:8" pos="0.5 0 1.1">
            <joint name="x_joint_cell:8" type="slide" axis="1 0 0"/>
            <joint name="z_joint_cell:8" type="slide" axis="0 0 1"/>
            <geom name="cell:8" type="sphere" size="0.1" mass="1" contype="1" conaffinity="2"/>
            <site name="site_cell:8" pos="0 0 0" size="0.01"/>
        </body>
        
        <body name="goal" pos="5.0 0.0 0.6">
            <!-- No joint means it's fixed -->
            <geom type="box" size="0.1 0.1 0.1" rgba="0 140 0 1" contype="0" conaffinity="0"/>
        </body>

        <body name="obsticle" pos="3.0 0.0 0.1">
            <!-- No joint means it's fixed -->
            <geom type="box" size="0.5 0.2 0.1" rgba="0 0 140 1"/>
        </body>
    </worldbody>

    <tendon>
        <spatial name="spring_0_1" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:0"/>
            <site site="site_cell:1"/>
        </spatial>

        <spatial name="spring_0_2" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:0"/>
            <site site="site_cell:2"/>
        </spatial>

        <spatial name="spring_1_3" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:1"/>
            <site site="site_cell:3"/>
        </spatial>

        <spatial name="spring_2_3" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:2"/>
            <site site="site_cell:3"/>
        </spatial>

        <spatial name="spring_1_2" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:1"/>
            <site site="site_cell:2"/>
        </spatial>

        <spatial name="spring_0_3" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:0"/>
            <site site="site_cell:3"/>
        </spatial>

        <spatial name="spring_1_4" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:1"/>
            <site site="site_cell:4"/>
        </spatial>

        <spatial name="spring_3_4" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:3"/>
            <site site="site_cell:4"/>
        </spatial>

        <spatial name="spring_4_5" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:4"/>
            <site site="site_cell:5"/>
        </spatial>

        <spatial name="spring_3_5" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:3"/>
            <site site="site_cell:5"/>
        </spatial>

        <spatial name="spring_1_5" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:1"/>
            <site site="site_cell:5"/>
        </spatial>

        <spatial name="spring_2_6" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:2"/>
            <site site="site_cell:6"/>
        </spatial>

        <spatial name="spring_3_6" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:3"/>
            <site site="site_cell:6"/>
        </spatial>

        <spatial name="spring_3_7" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:3"/>
            <site site="site_cell:7"/>
        </spatial>

        <spatial name="spring_6_7" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:6"/>
            <site site="site_cell:7"/>
        </spatial>

        <spatial name="spring_2_7" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:2"/>
            <site site="site_cell:7"/>
        </spatial>

        <spatial name="spring_5_8" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:5"/>
            <site site="site_cell:8"/>
        </spatial>

        <spatial name="spring_7_8" stiffness="150" damping="1" springlength="0.5">
            <site site="site_cell:7"/>
            <site site="site_cell:8"/>
        </spatial>

        <spatial name="spring_3_8" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:3"/>
            <site site="site_cell:8"/>
        </spatial>

        <spatial name="spring_5_7" stiffness="150" damping="1" springlength="0.707">
            <site site="site_cell:5"/>
            <site site="site_cell:7"/>
        </spatial>
    </tendon>

    <actuator>
        <motor joint="x_joint_cell:0" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:1" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:2" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:3" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:4" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:5" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:6" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:7" ctrlrange="-1 1" gear="2"/>
        <motor joint="x_joint_cell:8" ctrlrange="-1 1" gear="2"/>


        <motor joint="z_joint_cell:0" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:1" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:2" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:3" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:4" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:5" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:6" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:7" ctrlrange="-1 1" gear="2"/>
        <motor joint="z_joint_cell:8" ctrlrange="-1 1" gear="2"/>
    </actuator>
</mujoco>
